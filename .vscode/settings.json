{
  "C_Cpp.default.formatting": "file",
  "C_Cpp.default.intelliSenseMode": "${defaultIntelliSenseMode}",
  "C_Cpp.clang_format_language": "English",
  "editor.formatOnSave": true,
  "editor.insertSpaces": true,
  "editor.tabSize": 2,
  "files.associations": {
    "*.h": "c",
    "*.c": "c"
  },
  "cmake.configureOnOpen": false,
  "cmake.buildDirectory": "${workspaceFolder}/build"
}